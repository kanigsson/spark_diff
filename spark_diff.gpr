library project Spark_Diff is
   type Build_Mode is ("release", "checks");
   Build : Build_Mode := external ("DIFF_BUILD", "release");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Build & "/library";
   for Library_Dir use "lib/" & Build;
   for Library_Name use "spark_diff";
   for Library_Kind use "static";
   package Compiler is
      case Build is
         when "release" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwa");
         when "checks" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwa", "-gnata");
      end case;
   end Compiler;
   package Prove is
      for Proof_Dir use "proof";
      for Proof_Switches ("Ada") use
        ("--report=all", "--warnings=error", "--checks-as-errors=on");
   end Prove;
end Spark_Diff;
