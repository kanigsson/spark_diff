with "spark_diff.gpr";
project Tools is
   for Source_Dirs use ("cli", "tests");
   for Object_Dir use "obj/" & Spark_Diff.Build & "/tools";
   case Spark_Diff.Build is
      when "release" => for Exec_Dir use "bin";
      when "checks" => for Exec_Dir use "bin/checks";
   end case;
   for Main use ("spark_diff_cli.adb", "test_diff.adb");
   package Builder is
      for Executable ("spark_diff_cli.adb") use "spark-diff";
   end Builder;
   package Compiler is
      case Spark_Diff.Build is
         when "release" =>
            for Local_Configuration_Pragmas use "config/release.adc";
         when "checks" => null;
      end case;
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwa", "-gnata");
   end Compiler;
end Tools;
